{
    "manifest_version": 3,
    "name": "Facebook Marketplace Auto-Publisher",
    "version": "4.0",
    "description": "Herramienta de automatización modular PRO para publicar y extraer en Facebook Marketplace.",
    "icons": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    },
    "permissions": [
        "storage",
        "clipboardWrite",
        "unlimitedStorage"
    ],
    "host_permissions": [
        "https://www.facebook.com/*",
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.facebook.com/marketplace/*",
                "https://app.dropi.co/*",
                "https://www.facebook.com/*"
            ],
            "js": [
                "modules/state.js",
                "modules/license.js",
                "modules/fields/category.js",
                "modules/aiService.js",
                "modules/policyGuard.js",
                "modules/fields/condition.js",
                "modules/fields/tags.js",
                "modules/fields/delivery.js",
                "modules/fields/location.js",
                "modules/automation.js",
                "modules/extras.js",
                "modules/autoLoop.js",
                "modules/ui.js",
                "modules/main.js"
            ]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "styles.css"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}